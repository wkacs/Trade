# Neon Postgres
DATABASE_URL="postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# GLM API (Zhipu/Z.ai) — OpenAI-compatible endpoint.
# A base URL-nek egyeznie kell a kulcs kiállítójával (bigmodel.cn VAGY api.z.ai/api/paas/v4).
LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
LLM_API_KEY="your-zhipu-api-key-here"
# Verifikáltan elérhető ingyenes modell: glm-4.7-flash (a régi glm-4-flash már nincs).
# glm-5.2 fizetős (egyenleg-feltöltés kell).
LLM_MODEL_PHASE1="glm-4.7-flash"
LLM_MODEL_PHASE2="glm-5.2"

# Cron security
CRON_SECRET="some-random-secret-string"

# Trading mode: "paper" or "live"
TRADING_MODE="paper"

# Binance (csak live módban, 2. fázis)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# Opcionális hír/whale API kulcsok (a CryptoPanic ingyenes tier-je 2026-tól megszűnt,
# a WhaleAlert API is fizetős — nélkülük az ingyenes RSS + Fear&Greed forrás megy).
CRYPTOPANIC_TOKEN=""
WHALEALERT_KEY=""

# Opcionális Reddit social-gyűjtő — OAuth app kell (ingyenes: reddit.com/prefs/apps,
# "script" típus). A kulcs nélküli Reddit JSON-t a Reddit 403-mal tiltja.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
